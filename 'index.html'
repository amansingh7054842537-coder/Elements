<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Chemical Formulas Reference</title>
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Rajdhani:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #04080f;
    --panel: #080d1a;
    --border: #1a2744;
    --accent: #00d4ff;
    --accent2: #ff6b35;
    --accent3: #a8ff78;
    --text: #c8d8f0;
    --dim: #4a6080;

    --acid:     #ff4d6d;
    --base:     #4cc9f0;
    --oxide:    #ffd60a;
    --salt:     #7bed9f;
    --organic:  #c77dff;
    --gas:      #48cae4;
    --compound: #fb8500;
    --element:  #f72585;
    --hydro:    #a8ff78;
    --indicator:#ff6b35;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Rajdhani', sans-serif;
    min-height: 100vh;
    overflow-x: hidden;
  }

  .grain {
    position: fixed; inset: 0; pointer-events: none; z-index: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
    opacity: 0.6;
  }

  /* Animated background grid */
  .bg-grid {
    position: fixed; inset: 0; pointer-events: none; z-index: 0;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 60px 60px;
    opacity: 0.3;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 30%, transparent 100%);
  }

  .container {
    position: relative; z-index: 1;
    padding: 20px;
    max-width: 1500px;
    margin: 0 auto;
  }

  header {
    text-align: center;
    padding: 30px 0 20px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 24px;
    position: relative;
  }

  header h1 {
    font-family: 'Share Tech Mono', monospace;
    font-size: clamp(20px, 3vw, 40px);
    letter-spacing: 6px;
    color: var(--accent3);
    text-shadow: 0 0 30px rgba(168,255,120,0.5);
    text-transform: uppercase;
    animation: flicker 10s infinite;
  }

  header p {
    margin-top: 6px;
    font-size: 13px;
    letter-spacing: 3px;
    color: var(--dim);
    text-transform: uppercase;
  }

  @keyframes flicker {
    0%,94%,100%{opacity:1}95%{opacity:.8}96%{opacity:1}97%{opacity:.85}
  }

  /* LEGEND */
  .legend {
    display: flex; flex-wrap: wrap; gap: 8px;
    justify-content: center;
    margin-bottom: 24px;
  }

  .legend-item {
    display: flex; align-items: center; gap: 6px;
    font-size: 11px; letter-spacing: 1px;
    text-transform: uppercase; color: var(--dim);
    cursor: pointer;
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: 20px;
    transition: all 0.2s;
  }

  .legend-item:hover, .legend-item.active {
    color: var(--text);
    border-color: var(--item-color);
    box-shadow: 0 0 10px var(--item-color-alpha);
  }

  .legend-dot {
    width: 8px; height: 8px; border-radius: 50%;
    flex-shrink: 0;
  }

  /* FILTER / SEARCH BAR */
  .controls {
    display: flex; gap: 10px; flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 28px;
  }

  .search-wrap {
    position: relative;
  }

  .search-icon {
    position: absolute; left: 10px; top: 50%; transform: translateY(-50%);
    font-size: 14px; color: var(--dim); pointer-events: none;
  }

  .search-input {
    background: var(--panel);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 8px 14px 8px 32px;
    border-radius: 6px;
    font-family: 'Share Tech Mono', monospace;
    font-size: 13px;
    width: 260px;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .search-input:focus {
    border-color: var(--accent3);
    box-shadow: 0 0 12px rgba(168,255,120,0.2);
  }

  .search-input::placeholder { color: var(--dim); }

  .filter-btn {
    background: var(--panel);
    border: 1px solid var(--border);
    color: var(--dim);
    padding: 8px 16px;
    border-radius: 6px;
    font-family: 'Rajdhani', sans-serif;
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.2s;
  }

  .filter-btn:hover, .filter-btn.active {
    border-color: var(--accent3);
    color: var(--accent3);
    box-shadow: 0 0 10px rgba(168,255,120,0.2);
  }

  /* FORMULA CARDS */
  .formulas-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 12px;
    margin-bottom: 40px;
  }

  .formula-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px;
    cursor: pointer;
    transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s;
    position: relative;
    overflow: hidden;
    animation: fadeIn 0.4s ease both;
  }

  .formula-card::before {
    content: '';
    position: absolute; inset: 0;
    background: var(--cat-color);
    opacity: 0.05;
    border-radius: 8px;
    pointer-events: none;
  }

  .formula-card::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: var(--cat-color);
    opacity: 0.7;
  }

  .formula-card:hover {
    transform: translateY(-3px);
    border-color: var(--cat-color);
    box-shadow: 0 8px 24px rgba(0,0,0,0.4), 0 0 16px var(--cat-color-alpha);
  }

  .formula-card:hover::before { opacity: 0.1; }

  .card-top {
    display: flex; justify-content: space-between; align-items: flex-start;
    margin-bottom: 10px;
  }

  .card-formula {
    font-family: 'Share Tech Mono', monospace;
    font-size: 22px;
    font-weight: 700;
    color: var(--cat-color);
    text-shadow: 0 0 12px var(--cat-color);
    line-height: 1;
    letter-spacing: 1px;
  }

  .card-formula sub {
    font-size: 13px;
    vertical-align: sub;
  }

  .card-formula sup {
    font-size: 12px;
    vertical-align: super;
  }

  .card-badge {
    font-size: 9px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 12px;
    border: 1px solid var(--cat-color);
    color: var(--cat-color);
    opacity: 0.8;
    white-space: nowrap;
  }

  .card-name {
    font-size: 16px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 4px;
  }

  .card-hindi {
    font-size: 12px;
    color: var(--accent2);
    margin-bottom: 8px;
    letter-spacing: 0.5px;
  }

  .card-desc {
    font-size: 12px;
    color: var(--dim);
    line-height: 1.5;
    border-top: 1px solid var(--border);
    padding-top: 8px;
    margin-top: 4px;
  }

  .card-props {
    display: flex; gap: 6px; flex-wrap: wrap;
    margin-top: 8px;
  }

  .prop-tag {
    font-size: 10px;
    letter-spacing: 0.5px;
    padding: 2px 7px;
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--border);
    border-radius: 3px;
    color: var(--dim);
  }

  /* REACTION SECTION */
  .section-title {
    font-family: 'Share Tech Mono', monospace;
    font-size: 18px;
    letter-spacing: 4px;
    text-align: center;
    margin-bottom: 20px;
    padding-top: 30px;
    border-top: 1px solid var(--border);
    text-transform: uppercase;
  }

  .reaction-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 12px;
    margin-bottom: 40px;
  }

  .reaction-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px;
    transition: border-color 0.2s;
    animation: fadeIn 0.5s ease both;
  }

  .reaction-card:hover {
    border-color: var(--accent);
  }

  .reaction-title {
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 10px;
    font-weight: 600;
  }

  .reaction-eq {
    font-family: 'Share Tech Mono', monospace;
    font-size: 14px;
    color: var(--text);
    background: rgba(0,212,255,0.04);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 10px 12px;
    line-height: 1.8;
    margin-bottom: 8px;
    overflow-x: auto;
  }

  .reaction-eq .reactant { color: var(--accent2); }
  .reaction-eq .product  { color: var(--accent3); }
  .reaction-eq .arrow    { color: var(--accent); margin: 0 4px; }
  .reaction-eq .cond     { color: var(--dim); font-size: 11px; }

  .reaction-desc {
    font-size: 12px;
    color: var(--dim);
    line-height: 1.5;
  }

  .reaction-type-badge {
    display: inline-block;
    font-size: 9px;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 10px;
    margin-bottom: 8px;
  }

  /* STATS BAR */
  .stats-row {
    display: flex; gap: 16px; flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 28px;
  }

  .stat-box {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 12px 20px;
    text-align: center;
    min-width: 100px;
  }

  .stat-num {
    font-family: 'Share Tech Mono', monospace;
    font-size: 28px;
    color: var(--accent3);
    text-shadow: 0 0 16px rgba(168,255,120,0.4);
    line-height: 1;
  }

  .stat-lbl {
    font-size: 10px;
    letter-spacing: 1.5px;
    color: var(--dim);
    text-transform: uppercase;
    margin-top: 4px;
  }

  /* TOOLTIP */
  .tooltip {
    position: fixed;
    top: 20px; right: 20px;
    width: 280px;
    background: var(--panel);
    border: 1px solid var(--accent3);
    border-radius: 8px;
    padding: 16px;
    z-index: 100;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
    box-shadow: 0 0 30px rgba(168,255,120,0.15);
  }

  .tooltip.visible { opacity: 1; }

  .tt-formula {
    font-family: 'Share Tech Mono', monospace;
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 6px;
    line-height: 1;
  }

  .tt-name { font-size: 16px; font-weight: 700; margin-bottom: 2px; }
  .tt-hindi { font-size: 12px; color: var(--accent2); margin-bottom: 10px; }
  .tt-table { width: 100%; border-collapse: collapse; font-size: 12px; }
  .tt-table tr { border-bottom: 1px solid var(--border); }
  .tt-table td { padding: 5px 4px; }
  .tt-table td:first-child { color: var(--dim); font-size: 11px; letter-spacing: 1px; }
  .tt-table td:last-child { text-align: right; font-family: 'Share Tech Mono', monospace; color: var(--accent3); }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .count-display {
    text-align: center;
    font-size: 12px;
    color: var(--dim);
    margin-bottom: 16px;
    letter-spacing: 1px;
  }

  .no-results {
    text-align: center;
    padding: 60px 20px;
    color: var(--dim);
    font-family: 'Share Tech Mono', monospace;
    letter-spacing: 2px;
    font-size: 14px;
    grid-column: 1 / -1;
  }
</style>
</head>
<body>
<div class="grain"></div>
<div class="bg-grid"></div>
<div class="container">

  <header>
    <h1>Chemical Formulas</h1>
    <p>Acids · Bases · Salts · Oxides · Organic · Gases &amp; More</p>
  </header>

  <!-- STATS -->
  <div class="stats-row" id="statsRow"></div>

  <!-- LEGEND -->
  <div class="legend" id="legend"></div>

  <!-- CONTROLS -->
  <div class="controls">
    <div class="search-wrap">
      <span class="search-icon">⌕</span>
      <input class="search-input" id="searchInput" type="text" placeholder="Search formula or name...">
    </div>
    <button class="filter-btn active" onclick="setFilter('all',this)">All</button>
    <button class="filter-btn" onclick="setFilter('Acid',this)">Acids</button>
    <button class="filter-btn" onclick="setFilter('Base',this)">Bases</button>
    <button class="filter-btn" onclick="setFilter('Salt',this)">Salts</button>
    <button class="filter-btn" onclick="setFilter('Oxide',this)">Oxides</button>
    <button class="filter-btn" onclick="setFilter('Organic',this)">Organic</button>
    <button class="filter-btn" onclick="setFilter('Gas',this)">Gases</button>
    <button class="filter-btn" onclick="setFilter('Compound',this)">Compounds</button>
  </div>

  <div class="count-display" id="countDisplay"></div>
  <div class="formulas-grid" id="formulasGrid"></div>

  <!-- REACTIONS -->
  <div class="section-title" style="color:var(--accent2)">⟡ Important Chemical Reactions ⟡</div>
  <div class="reaction-grid" id="reactionGrid"></div>

</div>

<!-- TOOLTIP -->
<div class="tooltip" id="tooltip">
  <div class="tt-formula" id="tt-formula"></div>
  <div class="tt-name" id="tt-name"></div>
  <div class="tt-hindi" id="tt-hindi"></div>
  <table class="tt-table">
    <tr><td>Category</td><td id="tt-cat"></td></tr>
    <tr><td>Mol. Wt.</td><td id="tt-mw"></td></tr>
    <tr><td>State</td><td id="tt-state"></td></tr>
    <tr><td>pH</td><td id="tt-ph"></td></tr>
  </table>
</div>

<script>
