// ── RENDER FORMULA CARDS ──────────────────────────────────────
let currentFilter = 'all';
const grid = document.getElementById('formulasGrid');
const countDisp = document.getElementById('countDisplay');

function renderFormulas(filter = 'all', search = '') {
  grid.innerHTML = '';
  const ls = search.toLowerCase();
  const filtered = FORMULAS.filter(f => {
    const catMatch = filter === 'all' || f[3] === filter;
    const sMatch = !search ||
      f[0].toLowerCase().includes(ls) ||
      f[1].toLowerCase().includes(ls) ||
      f[2].includes(search);
    return catMatch && sMatch;
  });

  countDisp.textContent = `Showing ${filtered.length} of ${FORMULAS.length} formulas`;

  if (!filtered.length) {
    grid.innerHTML = '<div class="no-results">// NO RESULTS FOUND //</div>';
    return;
  }

  filtered.forEach((f, i) => {
    const [formula, name, hindi, cat, mw, state, ph, uses, tags] = f;
    const color = CATS[cat]?.color || 'var(--text)';
    const alpha = CATS[cat]?.alpha || 'rgba(200,200,200,0.1)';
    const card = document.createElement('div');
    card.className = 'formula-card';
    card.style.setProperty('--cat-color', color);
    card.style.setProperty('--cat-color-alpha', alpha);
    card.style.animationDelay = `${i * 30}ms`;

    const tagHtml = tags.map(t => `<span class="prop-tag">${t}</span>`).join('');

    card.innerHTML = `
      <div class="card-top">
        <div class="card-formula">${formula}</div>
        <div class="card-badge">${cat}</div>
      </div>
      <div class="card-name">${name}</div>
      <div class="card-hindi">${hindi}</div>
      <div class="card-desc">${uses}</div>
      <div class="card-props">${tagHtml}</div>
    `;
    card.addEventListener('mouseenter', () => showTip(f));
    card.addEventListener('mouseleave', hideTip);
    grid.appendChild(card);
  });
}

renderFormulas();

window.setFilter = function(cat, btn) {
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  currentFilter = cat;
  renderFormulas(cat, document.getElementById('searchInput').value);
};

document.getElementById('searchInput').addEventListener('input', e => {
  renderFormulas(currentFilter, e.target.value);
});

// ── TOOLTIP ───────────────────────────────────────────────────
const tt = document.getElementById('tooltip');
function showTip([formula, name, hindi, cat, mw, state, ph]) {
  const color = CATS[cat]?.color || 'var(--text)';
  tt.querySelector('#tt-formula').textContent = formula;
  tt.querySelector('#tt-formula').style.color = color;
  tt.querySelector('#tt-formula').style.textShadow = `0 0 16px ${color}`;
  tt.querySelector('#tt-name').textContent = name;
  tt.querySelector('#tt-hindi').textContent = hindi;
  tt.querySelector('#tt-cat').textContent = cat;
  tt.querySelector('#tt-cat').style.color = color;
  tt.querySelector('#tt-mw').textContent = mw + ' g/mol';
  tt.querySelector('#tt-state').textContent = state;
  tt.querySelector('#tt-ph').textContent = ph;
  tt.style.borderColor = color;
  tt.style.boxShadow = `0 0 30px ${CATS[cat]?.alpha || 'rgba(168,255,120,0.15)'}`;
  tt.classList.add('visible');
}
function hideTip() { tt.classList.remove('visible'); }

